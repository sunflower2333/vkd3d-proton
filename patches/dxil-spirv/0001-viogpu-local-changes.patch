+void ParseContext::emit_clip_cull_signature(const dxbc::Signature &signature)
+{
+	// The legalized IR combines each Clip/Cull builtin into a scalar array.
+	// Its eSemantic retains only one entry, so preserve every original semantic
+	// and mask independently for opt-in component stream-output remapping.
+	Vector<MDOperand *> entries;
+	for (const auto &e : signature)
+	{
+		DXIL::Semantic semantic;
+		if (e.getSystemValue() == dxbc::SignatureSysval::eClipDistance)
+			semantic = DXIL::Semantic::ClipDistance;
+		else if (e.getSystemValue() == dxbc::SignatureSysval::eCullDistance)
+			semantic = DXIL::Semantic::CullDistance;
+		else
+			continue;
+		entries.push_back(create_md_node(create_string_meta(e.getSemanticName()),
+		        create_constant_uint_meta(e.getSemanticIndex()), create_constant_uint_meta(e.getStreamIndex()),
+		        create_constant_uint_meta(unsigned(semantic)), create_constant_uint_meta(uint8_t(e.getComponentMask()))));
+	}
+	create_named_md_node("dxbc.clipCullOutputSignature", create_md_node(std::move(entries)));
+}

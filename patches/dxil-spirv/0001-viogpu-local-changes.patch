+static Operation *emit_variable_mip_dimensions(Converter::Impl &impl, Operation *base,
+                                              spv::Id image_type, spv::Id lod, unsigned num_coords)
+{
+	auto &builder = impl.builder();
+	auto uint_type = builder.makeUintType(32);
+	auto dim_type = impl.build_vector_type(uint_type, num_coords);
+	bool arrayed = builder.isArrayedImageType(image_type);
+	if (!impl.glsl_std450_ext)
+		impl.glsl_std450_ext = builder.import("GLSL.std.450");
+
+	// Even an out-of-range query must not cause an undefined >= 32 shift.
+	auto *shift = impl.allocate(spv::OpExtInst, uint_type);
+	shift->add_id(impl.glsl_std450_ext);
+	shift->add_literal(GLSLstd450UMin);
+	shift->add_ids({ lod, builder.makeUintConstant(31) });
+	impl.add(shift);
+
+	spv::Id shifts[4], minimums[4];
+	for (unsigned i = 0; i < num_coords; i++)
+	{
+		bool layer = arrayed && i + 1 == num_coords;
+		shifts[i] = layer ? builder.makeUintConstant(0) : shift->id;
+		minimums[i] = builder.makeUintConstant(layer ? 0 : 1);
+	}
+	auto *size = impl.allocate(spv::OpShiftRightLogical, dim_type);
+	size->add_ids({ base->id, impl.build_vector(uint_type, shifts, num_coords) });
+	impl.add(size);
+	auto *clamp = impl.allocate(spv::OpExtInst, dim_type);
+	clamp->add_id(impl.glsl_std450_ext);
+	clamp->add_literal(GLSLstd450UMax);
+	clamp->add_ids({ size->id, impl.build_vector(uint_type, minimums, num_coords) });
+	impl.add(clamp);
+
+	// A null view has zero base size. Do not turn its dimensions into one.
+	auto *nonzero = impl.allocate(spv::OpINotEqual, impl.build_vector_type(builder.makeBoolType(), num_coords));
+	nonzero->add_ids({ base->id, builder.makeNullConstant(dim_type) });
+	impl.add(nonzero);
+	auto *select = impl.allocate(spv::OpSelect, dim_type);
+	select->add_ids({ nonzero->id, clamp->id, builder.makeNullConstant(dim_type) });
+	impl.add(select);
+	return select;
+}
